# Copie como .env e ajuste os valores. Nunca versione o arquivo .env.
# Os comandos npm start/setup/backup/restore carregam este arquivo.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:3000
TZ=America/Sao_Paulo
# Para servidor público: PUBLIC_ORIGIN=https://seu-dominio e NODE_ENV=production.
# No Docker, HOST=0.0.0.0 e DATA_DIR=/var/lib/fluxosvisual vêm do compose.yaml.
# PORT altera a porta publicada no host; o container continua na porta 3000.
# Ajuste PUBLIC_ORIGIN junto com PORT para corresponder à URL do navegador.
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_QUOTA_BYTES=1073741824
# Integração opcional com scanner: executável recebe caminho de arquivo, sem shell.
# ATTACHMENT_SCAN_COMMAND=/usr/bin/clamdscan
# REQUIRE_ATTACHMENT_SCAN=true
# Defina o administrador no comando npm run setup -- --email ..., sem senha padrão.
